# Copy to .env.local and fill in. Never commit .env.local.

# Joomla Web Services API root. Must be the vhost, not localhost/company-profile/...
JOOMLA_API=http://company-profile.test/backend/api/index.php/v1

# Joomla admin → Users → Manage → your user → API Tokens
JOOMLA_TOKEN=

# Shared with the Joomla plugin at System → Plugins → Next Revalidate
REVALIDATE_SECRET=

# Contact form mail (optional — without SMTP_HOST + CONTACT_TO the form shows a
# WhatsApp fallback instead of a submit button). Any SMTP provider works
# (Gmail App Password, Mailgun, SendGrid, VPS Postfix, …).
#
# Shared hosting quirk (e.g. Rumahweb): the mail server's TLS certificate is
# usually issued for the server hostname, not for `webmail.<domain>`. Put the
# certificate's hostname here, or TLS verification fails with
# "Hostname/IP does not match certificate's altnames".
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); the route also infers this from port 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Where visitor messages land.
CONTACT_TO=
# Shown as the sender; defaults to SMTP_USER when empty. Keep it on the same
# domain as SMTP_HOST or providers may flag the mail as spam.
CONTACT_FROM=
